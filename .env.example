APP_NAME="SAE Kayen Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Default DB (interna Laravel) -----------------------------------------
DB_CONNECTION=sqlite

# --- SAE Kayen - MySQL/MariaDB ---------------------------------------------
DB_SAE_CONNECTION=mysql
DB_SAE_HOST=192.168.X.X
DB_SAE_PORT=3306
DB_SAE_DATABASE=sae_kayen
DB_SAE_USERNAME=sae_user
DB_SAE_PASSWORD=SU_PASSWORD_AQUI
DB_SAE_CHARSET=utf8mb4
DB_SAE_COLLATION=utf8mb4_unicode_ci

# --- SAE Kayen - PostgreSQL (opcional) ------------------------------------
DB_PG_HOST=
DB_PG_PORT=5432
DB_PG_DATABASE=
DB_PG_USERNAME=
DB_PG_PASSWORD=
DB_PG_SCHEMA=public
DB_PG_SSLMODE=prefer

# --- Cache & Sessions -------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=sae_dashboard

# --- Dashboard -------------------------------------------------------------
# true = datos ficticios (sin BD real necesaria)
DASHBOARD_DEMO=true
DASHBOARD_CACHE_TTL=300

# --- Mail (opcional) -------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@saekayen.gob.ar"
MAIL_FROM_NAME=""

VITE_APP_NAME=""